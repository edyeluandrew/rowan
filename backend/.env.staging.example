# Rowan backend — STAGING (phase-2/foundation branch)
# Copy to backend/.env.staging locally, or paste into Render service "rowan-backend-staging"
# NEVER commit filled-in secrets.

# ───── Server ─────
PORT=4000
NODE_ENV=staging

# ───── Database (Neon Postgres — MUST differ from production Supabase) ─────
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ───── Redis (Render Redis — can share prod instance for testnet staging) ─────
# Copy REDIS_URL from your existing Render backend service env vars.
# Separate staging Redis only needed when you scale to isolated prod/staging.
REDIS_URL=redis://red-xxxx:6379

# ───── Stellar (testnet — can match production testnet keys) ─────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
ESCROW_PUBLIC_KEY=G...
ESCROW_SECRET_KEY=S...
MARKET_MAKER_PUBLIC_KEY=G...
MARKET_MAKER_SECRET_KEY=S...

# ───── SEP-10 / stellar.toml ─────
SEP10_SIGNING_KEY=G...
SEP10_SIGNING_SECRET=S...
API_URL=https://rowan-backend-staging.onrender.com

# ───── JWT & encryption (use NEW values for staging, or copy prod testnet keys) ─────
JWT_SECRET=your-staging-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1h
JWT_TRADER_EXPIRES_IN=7d
ENCRYPTION_KEY=your-staging-encryption-key-min-32-chars

# ───── Platform ─────
PLATFORM_FEE_PERCENT=1
PLATFORM_SPREAD_PERCENT=1.25
MAX_SLIPPAGE_PERCENT=5
QUOTE_TTL_SECONDS=360
MIN_XLM_AMOUNT=2
TRADER_ACCEPT_TIMEOUT_SECONDS=180
TRADER_CONFIRM_TIMEOUT_SECONDS=300

# ───── USDC/Fiat (static fallback + Rwanda) ─────
USDC_RATE_UGX=3750
USDC_RATE_KES=153
USDC_RATE_TZS=2650
USDC_RATE_RWF=1300
FIAT_FX_ENABLED=true

# ───── CORS (staging frontends + local dev) ─────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://rowan-staging.vercel.app,https://rowan-admin-staging.vercel.app

# ───── Supabase Storage (can share prod project for testnet file uploads) ─────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ───── SMS (sandbox OK for staging) ─────
AT_API_KEY=your-at-api-key
AT_USERNAME=sandbox

# ───── Admin bootstrap ─────
ADMIN_EMAIL=admin@rowan.money
ADMIN_PASSWORD=CHANGE_ME_staging

# ───── Phase 2 utilities (Reloadly + USDC debit) ─────
# RELOADLY_CLIENT_ID=
# RELOADLY_CLIENT_SECRET=
# RELOADLY_MOCK_MODE=true
# UTILITY_ALLOW_MOCK_PURCHASE=true
# UTILITY_USDC_PUBLIC_KEY=G...  (defaults to ESCROW_PUBLIC_KEY)
# UTILITY_FEE_PERCENT=1

COINGECKO_API_URL=https://api.coingecko.com/api/v3
ORPHAN_FIAT_SENT_MINUTES=60
ORPHAN_MATCHED_MINUTES=30
ENABLE_SMS_FALLBACK=false
TESTNET_RECOVERY_WALLET_PUBLIC_KEY=G...
